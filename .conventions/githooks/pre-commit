#!/bin/sh
# Refuse a commit on a long-lived branch or on a branch that isn't named per Conventional Branch, then
# run the repo's own hook, if it has one, from .githooks/local/pre-commit.
#
# Enable it once per clone (see CONTRIBUTING.md; `conventions sync` does it for you):
#
#     git config core.hooksPath .conventions/githooks
#
# `git commit --no-verify` skips this, which is the escape hatch for the day you need it.
#
# Synced from vexouLuna/conventions: change it there, not here.
set -eu

top=$(git rev-parse --show-toplevel)

# Concluding a conflicted merge is a commit on the branch being merged into, which is exactly how work
# is meant to reach main. Let it through; the rule is about where work starts, not where it lands.
if [ ! -e "$(git rev-parse --git-path MERGE_HEAD)" ]; then
    # A detached HEAD is a rebase, a bisect or a deliberate look around: nothing to check.
    if branch=$(git symbolic-ref --quiet --short HEAD); then
        "$top/.conventions/githooks/check-branch-name.sh" "$branch"
    fi
fi

if [ -x "$top/.githooks/local/pre-commit" ]; then
    exec "$top/.githooks/local/pre-commit" "$@"
fi
